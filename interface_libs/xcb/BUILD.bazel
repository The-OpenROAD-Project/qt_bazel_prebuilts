# Headers-only target consumed by @xcb_util_cursor//:cursor (declared in
# this module's MODULE.bazel). Provides the xcb-util-image and
# xcb-util-renderutil headers that xcb-util-cursor #includes — neither
# upstream package is on BCR, so @libxcb (which only covers libxcb
# proper) doesn't supply them. libxcb-proper headers come from @libxcb.
cc_library(
    name = "xcb_hdrs",
    hdrs = [
        "xcb/xcb_image.h",
        "xcb/xcb_renderutil.h",
    ],
    includes = ["."],
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "xcb_render_util_ifso",
    interface_library = "libxcb-render-util.ifso",
    system_provided = True,
)

cc_import(
    name = "xcb_util_ifso",
    interface_library = "libxcb-util.ifso",
    system_provided = True,
)

cc_library(
    name = "xcb",
    hdrs = glob(["xcb/*.h"]),
    includes = ["."],
    strip_include_prefix = ".",
    visibility = ["//qt_source:__subpackages__"],
    deps = select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": [
            "@xcb_util_cursor//:cursor",
            ":xcb_icccm_ifso",
            ":xcb_ifso",
            ":xcb_image_ifso",
            ":xcb_keysyms_ifso",
            ":xcb_randr_ifso",
            ":xcb_render_ifso",
            ":xcb_render_util_ifso",
            ":xcb_shape_ifso",
            ":xcb_shm_ifso",
            ":xcb_sync_ifso",
            ":xcb_util_ifso",
            ":xcb_xfixes_ifso",
            ":xcb_xkb_ifso",
        ],
    }),
    linkopts = select({
        "@platforms//cpu:aarch64": [
            "-L/usr/lib/aarch64-linux-gnu",
            "-lxcb-cursor",
            "-lxcb-icccm",
            "-lxcb",
            "-lxcb-image",
            "-lxcb-keysyms",
            "-lxcb-randr",
            "-lxcb-render",
            "-lxcb-render-util",
            "-lxcb-shape",
            "-lxcb-shm",
            "-lxcb-sync",
            "-lxcb-util",
            "-lxcb-xfixes",
            "-lxcb-xkb",
        ],
        "//conditions:default": [],
    }),
)
