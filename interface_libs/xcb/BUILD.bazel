# Headers-only target consumed by @xcb_util_cursor//:cursor (declared in
# this module's MODULE.bazel) so xcb-util-cursor 0.1.5 source files can
# find xcb_renderutil.h, xcb_image.h, render.h etc. without pulling in
# the full :xcb target (which would create a circular dependency).
cc_library(
    name = "xcb_hdrs",
    hdrs = glob(["xcb/*.h"]),
    includes = ["."],
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)

# xcb-util-cursor 0.1.5 built from source via @xcb_util_cursor (declared
# in this module's MODULE.bazel). Replaces the system-provided
# libxcb-cursor.so.0 cc_import that used to live here.
alias(
    name = "xcb_cursor",
    actual = "@xcb_util_cursor//:cursor",
)

cc_import(
    name = "xcb_render_util_ifso",
    interface_library = "libxcb-render-util.ifso",
    system_provided = True,
)

cc_import(
    name = "xcb_util_ifso",
    interface_library = "libxcb-util.ifso",
    system_provided = True,
)

cc_library(
    name = "xcb",
    hdrs = glob(["xcb/*.h"]),
    includes = ["."],
    strip_include_prefix = ".",
    visibility = ["//qt_source:__subpackages__"],
    deps = select({
        "@platforms//cpu:aarch64": [],
        "//conditions:default": [
            ":xcb_cursor",
            ":xcb_icccm_ifso",
            ":xcb_ifso",
            ":xcb_image_ifso",
            ":xcb_keysyms_ifso",
            ":xcb_randr_ifso",
            ":xcb_render_ifso",
            ":xcb_render_util_ifso",
            ":xcb_shape_ifso",
            ":xcb_shm_ifso",
            ":xcb_sync_ifso",
            ":xcb_util_ifso",
            ":xcb_xfixes_ifso",
            ":xcb_xkb_ifso",
        ],
    }),
    linkopts = select({
        "@platforms//cpu:aarch64": [
            "-L/usr/lib/aarch64-linux-gnu",
            "-lxcb-cursor",
            "-lxcb-icccm",
            "-lxcb",
            "-lxcb-image",
            "-lxcb-keysyms",
            "-lxcb-randr",
            "-lxcb-render",
            "-lxcb-render-util",
            "-lxcb-shape",
            "-lxcb-shm",
            "-lxcb-sync",
            "-lxcb-util",
            "-lxcb-xfixes",
            "-lxcb-xkb",
        ],
        "//conditions:default": [],
    }),
)
